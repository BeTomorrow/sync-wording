{
  "name": "@betomorrow/sync-wording",
  "version": "2.0.0",
  "description": "Provide tool to retrieve app wording from Google Sheet and process it to generate i18n json files",
  "main": "lib/index.js",
  "bin": "lib/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "watch": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts --upgrade --invalid error",
    "build": "tsc -p .",
    "test": "npm run build",
    "installPackage": "npm run build && npm i -g",
    "refresh": "rm -rf ./node_modules ./package-lock.json && npm install"
  },
  "author": "Olivier Gauthier",
  "homepage": "https://github.com/BeTomorrow/sync-wording",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "clear": "^0.1.0",
    "colors": "^1.4.0",
    "commander": "^14.0.3",
    "figlet": "^1.11.0",
    "googleapis": "^171.4.0",
    "open": "^11.0.0",
    "path": "^0.12.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/clear": "^0.1.4",
    "@types/figlet": "^1.7.0",
    "@types/node": "^25.9.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "files": [
    "lib/",
    "skills/",
    "examples/"
  ]
}
